# Copia este archivo a .env para desarrollo local (nunca subir .env real a git).
# En cPanel, estas mismas claves se configuran como Environment Variables en
# Setup Node.js App — ver DEPLOY_CPANEL.md en apps/api.

PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=meperdi_dev
DB_USER=mauricio
DB_PASSWORD=

# Blockchain (HSK testnet)
HSK_RPC_URL=https://testnet.hsk.xyz
HSK_CHAIN_ID=133
RECOVERY_ESCROW_ADDRESS=
MOCK_USDC_ADDRESS=
VERIFIER_PRIVATE_KEY=
DEMO_OWNER_PRIVATE_KEY=
CHAIN_DEMO_SECRET=

# Avalanche Fuji testnet (bounty)
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_CHAIN_ID=43113
AVALANCHE_RECOVERY_ESCROW_ADDRESS=
AVALANCHE_MOCK_USDC_ADDRESS=

# Login con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe ser EXACTAMENTE la misma URL registrada en Google Cloud Console.
# Local:      http://localhost:5173/auth/callback/google
# Producción: https://appweb.meperdi.com/auth/callback/google
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

# Sesión propia (cookie httpOnly) tras un login exitoso
JWT_SECRET=
# Vacío en local. En producción: .meperdi.com (con el punto), para compartir la
# cookie entre appweb.meperdi.com y apiappweb.meperdi.com.
COOKIE_DOMAIN=